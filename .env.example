# Copy this file to .env and adjust paths for your machine.
# Never commit .env — it contains paths specific to your environment.

# Path to the MVTec Anomaly Detection dataset root
# (the folder that contains bottle/, cable/, capsule/, etc.)
MVTEC_PATH=$HOME/dev/telecom/stage_1a_data/mvtec_anomaly_detection

# MLflow tracking database (relative to repo root)
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
